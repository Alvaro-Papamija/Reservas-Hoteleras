{
  "info": {
    "_postman_id": "hotel-alborada-sprint2-collection",
    "name": "Hotel Alborada Boutique - Sprint 2 REST API",
    "description": "Colección completa oficial de pruebas y documentación de endpoints para el Sprint 2:\n1. Autenticación y Autorización (JWT, BCrypt, RBAC)\n2. CRUD de Inventario de Habitaciones\n3. CRUD de Expedientes de Reservas\n4. CRUD de Fichas de Clientes\n5. Registro y Liquidación de Pagos\n6. Catálogos Maestros (Tipos de Habitación y Cupones)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación y Autorización",
      "item": [
        {
          "name": "1.1 Login Administrador (Auto-guarda JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    console.log('JWT Token guardado:', jsonData.token);",
                  "}",
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna token JWT y rol ADMINISTRADOR', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.rol).to.eql('ADMINISTRADOR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"alvaro@hotelalborada.com\",\n  \"contrasena\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.2 Login Recepcionista",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "}",
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"recepcion@hotelalborada.com\",\n  \"contrasena\": \"Recepcion123*\"\n}"
